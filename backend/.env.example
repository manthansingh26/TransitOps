# --- Database ---
# PostgreSQL connection string used by SQLAlchemy + Alembic.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/transitops

# --- Security ---
# Generate a strong key, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- App ---
DEBUG=true
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
